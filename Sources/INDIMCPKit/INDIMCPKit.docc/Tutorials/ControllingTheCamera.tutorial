@Tutorial(time: 15) {
    @Intro(title: "Controlling the Camera") {
        Drive a ``Camera`` end to end: connect a client, resolve a rig-scoped camera handle,
        cool it to a target temperature, capture a single exposure, then follow the resulting
        frame through download, checksum verification, and transfer confirmation.
    }

    @Section(title: "Connect and resolve a camera handle") {
        @ContentAndMedia {
            Every INDIMCPKit call goes through an ``INDIMCPClient``. Connect it, start INDI
            messaging (the device handles' connectivity checks and ``Camera/isCoolerOn()``
            both depend on it), then resolve a rig-scoped ``Camera`` handle.
        }

        @Steps {
            @Step {
                Create a client pointed at your INDIMCP-server instance and connect it.

                @Code(name: "ControllingTheCamera.swift", file: "01-connect.swift")
            }

            @Step {
                Start INDI messaging so the camera's connectivity checks — and later,
                ``Camera/isCoolerOn()`` — have live events to work from.

                @Code(name: "ControllingTheCamera.swift", file: "02-start-messaging.swift")
            }

            @Step {
                Resolve a rig-scoped ``Camera`` handle. Devices aren't addressed by name
                directly; they're reached through a saved rig's `camera` role.

                @Code(name: "ControllingTheCamera.swift", file: "03-camera-handle.swift")
            }
        }
    }

    @Section(title: "Cool the camera") {
        @ContentAndMedia {
            Cooling runs as a script on the server, so it returns a ``ScriptRunStarted``
            immediately rather than blocking until the target temperature is reached. Wait for
            it to finish, then confirm the cooler switch actually turned on.
        }

        @Steps {
            @Step {
                Cool the camera to a target temperature and wait for the run to finish.

                @Code(name: "ControllingTheCamera.swift", file: "04-cool-camera.swift")
            }

            @Step {
                Confirm the cooler is on. ``Camera/isCoolerOn()`` reports the most recently
                observed `CCD_COOLER` event, so treat `nil` as "unknown," not "off."

                @Code(name: "ControllingTheCamera.swift", file: "05-is-cooler-on.swift")
            }
        }
    }

    @Section(title: "Capture a frame") {
        @ContentAndMedia {
            Capture a single exposure with ``Camera/captureFrame(exposureSeconds:frameType:binningX:binningY:gain:offset:frameX:frameY:frameWidth:frameHeight:locationId:)``,
            choosing a frame type and, if the camera supports it, a gain/offset pair. Like
            every device command, this returns a run to wait on rather than a result.
        }

        @Steps {
            @Step {
                Capture a 30-second light frame at a specific gain and offset, then wait for
                the run to complete.

                @Code(name: "ControllingTheCamera.swift", file: "06-capture-frame.swift")
            }

            @Step {
                Check the terminal status. `waitForTerminalStatus` can also return `.failed`,
                `.cancelled`, or the other non-`.completed` cases in ``ScriptRunStatus`` — handle
                those before assuming a frame was captured.

                @Code(name: "ControllingTheCamera.swift", file: "07-check-completed.swift")
            }
        }
    }

    @Section(title: "Retrieve and verify the frame") {
        @ContentAndMedia {
            A captured exposure is tracked server-side as frame metadata, separate from its
            image bytes. List the frames this run produced, download one, verify its checksum,
            and only then confirm the transfer — confirming an unverified download risks the
            server treating a corrupted copy as safe to delete.
        }

        @Steps {
            @Step {
                List the frames captured by this run and pick the one to download.

                @Code(name: "ControllingTheCamera.swift", file: "08-list-frames.swift")
            }

            @Step {
                Download the frame's raw bytes to a local file. `downloadFrame` streams the
                transfer straight to disk — it never buffers a whole frame in memory.

                @Code(name: "ControllingTheCamera.swift", file: "09-download-frame.swift")
            }

            @Step {
                Verify the downloaded bytes against the server-reported checksum before
                confirming the transfer. Never call `confirmFrameTransfer` before verification
                passes — see <doc:ChecksumVerification> for why.

                @Code(name: "ControllingTheCamera.swift", file: "10-verify-and-confirm.swift")
            }
        }
    }
}
